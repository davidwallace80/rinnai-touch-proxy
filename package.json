{
  "name": "rinnai-touch-proxy",
  "version": "1.0.0",
  "scripts": {
    "depcheck": "depcheck --skip-missing --oneline --ignores @trivago/prettier-plugin-sort-imports",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "lint": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "validate": "npm run depcheck && npm run format && npm run lint && npm run type-check",
    "build": "npm run validate && esbuild --bundle src/index.ts --outfile=dist/index.js --platform=node --minify",
    "build:dev": "esbuild --bundle src/index.ts --outfile=dist/index.js --platform=node --sourcemap ",
    "start:build": "node dist/index.js",
    "start": "tsx src/index.ts",
    "watch": "tsx watch src/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "dotenv": "^17.2.1",
    "lodash": "^4.17.21",
    "mqtt": "^5.7.0",
    "tslog": "^4.9.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@types/lodash": "^4.17.14",
    "@types/node": "^24.2.1",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "depcheck": "^1.4.7",
    "esbuild": "^0.25.9",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^16.3.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
